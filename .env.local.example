# Copy this file to .env.local and edit.
# Address of your FastAPI backend (no trailing slash). Next.js forwards /api and /uploads to it.
BACKEND_URL=http://127.0.0.1:8001

# Optional: WebSocket address for instant chat. Default is derived (admin.example.com -> api.example.com).
# NEXT_PUBLIC_WS_URL=wss://api.akhilifestyle.com/api/v1
