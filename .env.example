# ===== এই ফাইলটা কপি করে .env.local নাম দিন, তারপর মান বসান =====

# আপনার লাইভ Backend API (শেষে /api/v1 থাকতে হবে, শেষে / দেবেন না)
NEXT_PUBLIC_API_URL=https://api.akhilifestyle.com/api/v1

# এই ওয়েবসাইটের লাইভ ঠিকানা — https://akhilifestyle.com হতেই হবে (WhatsApp/Facebook লিংক প্রিভিউ এটা দিয়ে বানায়)
NEXT_PUBLIC_SITE_URL=https://akhilifestyle.com

# দোকানের তথ্য (Footer, Contact, SEO তে দেখাবে)
NEXT_PUBLIC_SITE_NAME=Akhi Lifestyle
NEXT_PUBLIC_TAGLINE=Style · Accessories · You
NEXT_PUBLIC_PHONE=+880 1234 567890
NEXT_PUBLIC_EMAIL=akhilifestyle@gmail.com
NEXT_PUBLIC_ADDRESS=ঢাকা, বাংলাদেশ

# সোশ্যাল / সাপোর্ট লিংক (ফাঁকা রাখলে বাটন দেখাবে না)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
